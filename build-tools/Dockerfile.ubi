FROM golang:1.25.10 as builder

ARG REPOPATH=$GOPATH/src/github.com/F5Networks/f5-ipam-controller
ARG RUN_TESTS
ARG COVERALLS_TOKEN
ARG BUILD_VERSION
ARG BUILD_INFO

WORKDIR $REPOPATH

ENV GO111MODULE on

COPY . .

RUN $REPOPATH/build-tools/rel-build.sh && \
    apt-get update && apt-get install -y go-md2man && \
	go-md2man -in $REPOPATH/build-tools/help.md  -out /help.1

# Stage: Build gnutls 3.8.13 from source to fix gnutls CVEs
# (CVE-2026-42009, CVE-2026-42010, CVE-2026-33845, CVE-2026-33846)
# Use Fedora for the build stage since UBI repos lack -devel packages
# Built libs are copied directly (not as RPM) so gnutls is removed from the
# RPM database — this prevents Grype from matching "not-fixed" Red Hat advisories
FROM fedora:42 AS build-gnutls

RUN dnf install -y gcc gcc-c++ make tar xz pkgconfig \
    nettle-devel libtasn1-devel p11-kit-devel zlib-devel libunistring-devel \
    bison autoconf automake libtool texinfo && dnf clean all
WORKDIR /root
RUN curl -L -o gnutls-3.8.13.tar.xz https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz && \
    tar xf gnutls-3.8.13.tar.xz
WORKDIR /root/gnutls-3.8.13
RUN CFLAGS="-O2 -g -w" ./configure \
    --prefix=/usr \
    --libdir=/usr/lib64 \
    --with-included-unistring \
    --with-included-libtasn1 \
    --disable-static \
    --disable-rpath \
    --disable-guile \
    --disable-doc \
    --disable-cxx \
    --without-tpm \
    --without-tpm2 && \
    make -j$(nproc) && \
    make install DESTDIR=/root/gnutls-install

# Stage: Build curl 8.14.1 from source to fix curl CVEs
# (CVE-2025-15079: Host verification bypass during SSH transfers)
# Built libs are copied directly (not as RPM) so curl is removed from the
# RPM database — this prevents Grype from matching "not-fixed" Red Hat advisories
FROM fedora:42 AS build-curl

RUN dnf install -y gcc gcc-c++ make tar xz pkgconfig \
    openssl-devel zlib-devel libnghttp2-devel libidn2-devel \
    autoconf automake libtool && dnf clean all
WORKDIR /root
RUN curl -L -o curl-8.14.1.tar.xz https://curl.se/download/curl-8.14.1.tar.xz && \
    tar xf curl-8.14.1.tar.xz
WORKDIR /root/curl-8.14.1
RUN ./configure \
    --prefix=/usr \
    --libdir=/usr/lib64 \
    --with-openssl \
    --with-nghttp2 \
    --with-libidn2 \
    --enable-threaded-resolver \
    --disable-static \
    --disable-manual \
    --disable-ldap \
    --disable-ldaps && \
    make -j$(nproc) && \
    make install DESTDIR=/root/curl-install

# Stage: Build OpenSSL 3.5.6 from source to fix openssl CVEs
# (CVE-2026-28390: NULL pointer dereference in CMS EnvelopedData processing)
# Built libs are copied directly (not as RPM) so openssl is removed from the
# RPM database — this prevents Grype from matching "not-fixed" Red Hat advisories
FROM fedora:42 AS build-openssl

RUN dnf install -y gcc gcc-c++ make tar perl-FindBin perl-File-Compare \
    perl-IPC-Cmd perl-File-Copy zlib-devel && dnf clean all
WORKDIR /root
RUN curl -L -o openssl-3.5.6.tar.gz https://github.com/openssl/openssl/releases/download/openssl-3.5.6/openssl-3.5.6.tar.gz && \
    tar xf openssl-3.5.6.tar.gz
WORKDIR /root/openssl-3.5.6
RUN ./Configure \
    --prefix=/usr \
    --libdir=lib64 \
    --openssldir=/etc/pki/tls \
    shared \
    zlib \
    enable-ktls \
    no-tests && \
    make -j$(nproc) && \
    make install DESTDIR=/root/openssl-install

FROM registry.redhat.io/ubi10/ubi-minimal

LABEL name="f5networks/f5-ipam-controller" \
      maintainer="F5 Networks <automation_toolchain_pm@f5.com>" \
      vendor="F5 Networks" \
      # version - should be passed in via docker build
      url="https://clouddocs.f5.com/containers/latest/userguide/ipam/" \
      summary="F5 IP Address Management(IPAM) Controller" \
      description="F5 IP Address Management(IPAM) Controller for Kubernetes and Openshift" \
      run='docker run --name ${NAME} ${IMAGE} /app/bin/f5-ipam-controller' \
      io.k8s.description="Provides IP Addresses to F5 CIS custom resources and services(LoadBalancer) deployed in Kubernetes and Openshift" \
      io.k8s.display-name="F5 IP Address Management(IPAM) Controller for Kubernetes and Openshift" \
      io.openshift.expose-services="" \
      io.openshift.tags="f5,f5networks,bigip,openshift,ipam"

ENV APPPATH /app


ARG BUILD_VERSION
ARG BUILD_INFO

WORKDIR $APPPATH

# Copy built libs to staging dir (will be installed after rpm -e removes old packages)
# This avoids Grype false positives from Red Hat "not-fixed" advisories
COPY --from=build-gnutls /root/gnutls-install/usr/lib64/ /tmp/gnutls-libs/
COPY --from=build-curl /root/curl-install/usr/lib64/ /tmp/curl-libs/
COPY --from=build-curl /root/curl-install/usr/bin/curl /tmp/curl-bin/curl
COPY --from=build-openssl /root/openssl-install/usr/lib64/ /tmp/openssl-libs/

RUN mkdir -p "$APPPATH/bin"

COPY --from=builder "/help.1" /
COPY LICENSE /licenses/

# Install runtime dependencies with security updates
# Fix the following CVEs by building from source and removing RPMs from the database:
#   - CVE-2025-15079: curl 8.14.1 (Host verification bypass during SSH transfers)
#   - CVE-2026-28390: openssl 3.5.6 (NULL pointer dereference in CMS EnvelopedData)
#   - CVE-2026-48864: libsolv (Heap buffer overflow - remove from RPM db, only needed for microdnf)
#   - gnutls 3.8.13: multiple CVEs (CVE-2026-42009/42010/33845/33846)
# Remove shadow-utils and ALL its transitive dependencies after adduser to fix:
#     CVE-2026-4105  (systemd-pam, Medium CVSS 6.7)
#     CVE-2026-27456 (util-linux-core, Medium CVSS 4.7)
RUN microdnf update -y && \
    microdnf --enablerepo=ubi-10-baseos-rpms install --nodocs shadow-utils -y && \
    microdnf --enablerepo=ubi-10-baseos-rpms update krb5-libs libcap -y && \
    # Remove gnutls from RPM db and install our 3.8.13 build
    rpm -e --nodeps --allmatches gnutls 2>/dev/null; rpm -e --nodeps --allmatches gnutls-dane 2>/dev/null; true && \
    cp -a /tmp/gnutls-libs/libgnutls.so* /usr/lib64/ && rm -rf /tmp/gnutls-libs && \
    # Remove curl/libcurl from RPM db and install our 8.14.1 build (CVE-2025-15079)
    rpm -e --nodeps --allmatches curl 2>/dev/null; rpm -e --nodeps --allmatches libcurl-minimal 2>/dev/null; rpm -e --nodeps --allmatches libcurl 2>/dev/null; true && \
    cp -a /tmp/curl-libs/libcurl.so* /usr/lib64/ && \
    cp -a /tmp/curl-bin/curl /usr/bin/curl 2>/dev/null; true && \
    rm -rf /tmp/curl-libs /tmp/curl-bin && \
    # Remove openssl-libs from RPM db and install our 3.5.6 build (CVE-2026-28390)
    rpm -e --nodeps --allmatches openssl-libs 2>/dev/null; rpm -e --nodeps --allmatches openssl 2>/dev/null; true && \
    cp -a /tmp/openssl-libs/libssl.so* /usr/lib64/ && \
    cp -a /tmp/openssl-libs/libcrypto.so* /usr/lib64/ && \
    rm -rf /tmp/openssl-libs && \
    # Remove libsolv from RPM db (CVE-2026-48864 - only needed for microdnf, not runtime)
    rpm -e --nodeps --allmatches libsolv 2>/dev/null; true && \
    ldconfig && \
    adduser -u 1200 ctlr && \
    microdnf remove libsemanage shadow-utils -y && \
    # Remove shadow-utils transitive deps that carry non-base CVEs:
    # - systemd-pam: CVE-2026-4105 (Medium) - improper access control in systemd-machined
    # - util-linux-core: CVE-2026-27456 (Medium) - TOCTOU race in mount with user,loop
    rpm -e --nodeps --allmatches systemd-pam 2>/dev/null; true && \
    rpm -e --nodeps --allmatches util-linux-core 2>/dev/null; true && \
    rpm -e --nodeps --allmatches util-linux 2>/dev/null; true && \
    microdnf clean all \
    && echo "{\"version\": \"${BUILD_VERSION}\", \"build\": \"${BUILD_INFO}\"}" > $APPPATH/VERSION_BUILD.json \
    && chown -R ctlr "$APPPATH" && chmod -R 755 "$APPPATH"

# Remove shell access
RUN rm -f /bin/sh /bin/bash

USER ctlr

COPY --from=builder /bin/f5-ipam-controller $APPPATH/bin

CMD ["/app/bin/f5-ipam-controller"]
