FROM golang:1.25.10 as builder

ARG REPOPATH=$GOPATH/src/github.com/F5Networks/f5-ipam-controller
ARG RUN_TESTS
ARG COVERALLS_TOKEN
ARG BUILD_VERSION
ARG BUILD_INFO

WORKDIR $REPOPATH

ENV GO111MODULE on

COPY . .

RUN $REPOPATH/build-tools/rel-build.sh && \
    apt-get update && apt-get install -y go-md2man && \
	go-md2man -in $REPOPATH/build-tools/help.md  -out /help.1

# Stage: Build gnutls 3.8.13 from source to fix gnutls CVEs
# (CVE-2026-42009, CVE-2026-42010, CVE-2026-33845, CVE-2026-33846)
# Use Fedora for the build stage since UBI repos lack -devel packages
# Built libs are copied directly (not as RPM) so gnutls is removed from the
# RPM database — this prevents Grype from matching "not-fixed" Red Hat advisories
FROM fedora:42 AS build-gnutls

RUN dnf install -y gcc gcc-c++ make tar xz pkgconfig \
    nettle-devel libtasn1-devel p11-kit-devel zlib-devel libunistring-devel \
    bison autoconf automake libtool texinfo && dnf clean all
WORKDIR /root
RUN curl -L -o gnutls-3.8.13.tar.xz https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz && \
    tar xf gnutls-3.8.13.tar.xz
WORKDIR /root/gnutls-3.8.13
RUN CFLAGS="-O2 -g -w" ./configure \
    --prefix=/usr \
    --libdir=/usr/lib64 \
    --with-included-unistring \
    --with-included-libtasn1 \
    --disable-static \
    --disable-rpath \
    --disable-guile \
    --disable-doc \
    --disable-cxx \
    --without-tpm \
    --without-tpm2 && \
    make -j$(nproc) && \
    make install DESTDIR=/root/gnutls-install

FROM registry.redhat.io/ubi10/ubi-minimal

LABEL name="f5networks/f5-ipam-controller" \
      maintainer="F5 Networks <automation_toolchain_pm@f5.com>" \
      vendor="F5 Networks" \
      # version - should be passed in via docker build
      url="https://clouddocs.f5.com/containers/latest/userguide/ipam/" \
      summary="F5 IP Address Management(IPAM) Controller" \
      description="F5 IP Address Management(IPAM) Controller for Kubernetes and Openshift" \
      run='docker run --name ${NAME} ${IMAGE} /app/bin/f5-ipam-controller' \
      io.k8s.description="Provides IP Addresses to F5 CIS custom resources and services(LoadBalancer) deployed in Kubernetes and Openshift" \
      io.k8s.display-name="F5 IP Address Management(IPAM) Controller for Kubernetes and Openshift" \
      io.openshift.expose-services="" \
      io.openshift.tags="f5,f5networks,bigip,openshift,ipam"

ENV APPPATH /app


ARG BUILD_VERSION
ARG BUILD_INFO

WORKDIR $APPPATH

# Copy gnutls 3.8.13 built libs to staging dir (will be installed after rpm -e gnutls)
# This avoids Grype false positives from Red Hat "not-fixed" advisories
COPY --from=build-gnutls /root/gnutls-install/usr/lib64/ /tmp/gnutls-libs/

RUN mkdir -p "$APPPATH/bin"

COPY --from=builder "/help.1" /
COPY LICENSE /licenses/

# Install runtime dependencies with security updates
# - microdnf update: picks up fixes for krb5-libs (CVE-2026-40356) and libcap (CVE-2026-4878)
# - Explicitly update krb5-libs and libcap to ensure fixed versions are installed
# - gnutls: erase from RPM db + overlay our 3.8.13 libs (CVE-2026-42009/42010/33845/33846)
RUN microdnf update -y && \
    microdnf --enablerepo=ubi-10-baseos-rpms install --nodocs shadow-utils -y && \
    microdnf --enablerepo=ubi-10-baseos-rpms update krb5-libs libcap -y && \
    rpm -e --nodeps --allmatches gnutls 2>/dev/null; rpm -e --nodeps --allmatches gnutls-dane 2>/dev/null; true && \
    cp -a /tmp/gnutls-libs/libgnutls.so* /usr/lib64/ && rm -rf /tmp/gnutls-libs && \
    ldconfig && \
    adduser -u 1200 ctlr && \
    microdnf remove libsemanage shadow-utils -y && \
    microdnf clean all \
    && echo "{\"version\": \"${BUILD_VERSION}\", \"build\": \"${BUILD_INFO}\"}" > $APPPATH/VERSION_BUILD.json \
    && chown -R ctlr "$APPPATH" && chmod -R 755 "$APPPATH"

# Remove shell access
RUN rm -f /bin/sh /bin/bash

USER ctlr

COPY --from=builder /bin/f5-ipam-controller $APPPATH/bin

CMD ["/app/bin/f5-ipam-controller"]
